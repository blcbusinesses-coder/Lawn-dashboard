{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js dev server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Landing preview (dummy Supabase keys)",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321&& set NEXT_PUBLIC_SUPABASE_ANON_KEY=local-preview-key&& npx next dev -p 3001"
      ],
      "port": 3001
    }
  ]
}
